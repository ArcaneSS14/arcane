<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc 'arcane-sponsor-window-title'}"
    MinSize="620 490"
    SetSize="650 540">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Text="{Loc 'arcane-sponsor-window-intro'}" StyleClasses="LabelHeadingBigger" />
        <TabContainer Name="Tabs" VerticalExpand="True">
            <ScrollContainer VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="8 0" SeparationOverride="0" >
                    <PanelContainer StyleClasses="ArcaneLobbySurface">
                        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="3">
                            <Label Text="{Loc 'arcane-sponsor-tier-one-title'}" StyleClasses="LabelHeadingBigger" FontColorOverride="#C9A8D9" />
                            <Label Text="{Loc 'arcane-sponsor-tier-one-queue'}" />
                            <Label Text="{Loc 'arcane-sponsor-tier-one-discord'}" />
                            <Label Text="{Loc 'arcane-sponsor-tier-one-ooc'}" />
                        </BoxContainer>
                    </PanelContainer>
                    <PanelContainer StyleClasses="ArcaneLobbySurface" Margin="0" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="3">
                            <Label Text="{Loc 'arcane-sponsor-tier-two-title'}" StyleClasses="LabelHeadingBigger" FontColorOverride="#D7B56D" />
                            <Label Text="{Loc 'arcane-sponsor-tier-two-uniforms'}" />
                            <Label Text="{Loc 'arcane-sponsor-tier-two-ghosts'}" />
                            <Label Text="{Loc 'arcane-sponsor-tier-two-jobs'}" />
                            <Label Text="{Loc 'arcane-sponsor-tier-two-themes'}" />
                            <Label Text="{Loc 'arcane-sponsor-tier-two-boombox'}" />
                            <Label Text="{Loc 'arcane-sponsor-tier-two-discord'}" />
                            <Label Text="{Loc 'arcane-sponsor-tier-two-ooc'}" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </ScrollContainer>
            <ScrollContainer VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="8">
                    <BoxContainer Name="GhostRows" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6" />
                </BoxContainer>
            </ScrollContainer>
            <ScrollContainer VerticalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="8">
                    <Label Text="{Loc 'arcane-sponsor-themes-intro'}" />
                    <BoxContainer Name="ThemeList" Orientation="Vertical" SeparationOverride="8" />
                </BoxContainer>
            </ScrollContainer>
        </TabContainer>
    </BoxContainer>
</DefaultWindow>
