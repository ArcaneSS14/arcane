<surgery:SurgeryOperationsPopup
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:surgery="clr-namespace:Content.Client._Arcane.Medical.Surgery">
    <PanelContainer StyleClasses="ArcaneDetailSurface" MinWidth="280">
        <BoxContainer Orientation="Vertical">
            <controls:StripeBack Name="DragHandle" StyleClasses="ArcaneDetailStripe" MouseFilter="Stop" DefaultCursorShape="Hand">
                <Label Name="TitleLabel" StyleClasses="LabelKeyText" HorizontalAlignment="Center" Margin="8 2" />
            </controls:StripeBack>
            <BoxContainer Name="Operations" Orientation="Vertical" SeparationOverride="2" Margin="4 0 4 4" />
            <Label Name="EmptyLabel" Text="{Loc 'surgery-ui-popup-empty'}" StyleClasses="LabelSubText"
                   HorizontalAlignment="Center" Margin="8 4 8 8" Visible="False" />
        </BoxContainer>
    </PanelContainer>
</surgery:SurgeryOperationsPopup>
