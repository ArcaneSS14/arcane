<surgery:SurgeryStepRow
    xmlns="https://spacestation14.io"
    xmlns:surgery="clr-namespace:Content.Client._Arcane.Medical.Surgery"
    HorizontalExpand="True">
    <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="6 4">
        <Label Name="NumberLabel" MinWidth="20" Align="Center" VerticalAlignment="Center" />
        <TextureRect Name="Icon" SetSize="32 32" Stretch="KeepAspectCentered" VerticalAlignment="Center" />
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
            <Label Name="NameLabel" ClipText="True" />
            <RichTextLabel Name="WarningLabel" Visible="False" />
        </BoxContainer>
        <Label Name="ActiveLabel" Text="{Loc 'surgery-ui-step-active'}" StyleClasses="status-okay"
               VerticalAlignment="Center" Visible="False" />
    </BoxContainer>
</surgery:SurgeryStepRow>
