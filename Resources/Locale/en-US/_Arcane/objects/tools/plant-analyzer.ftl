# Analyzer
ent-PlantAnalyzer = plant analyzer
    .desc = Device developed by the Green Group for analyzing the state of plants and their chemical composition. May Sporwyn be glad!

# Analyzer Window
plant-analyzer-window-title = Plant Analyzer

# Window Sections
plant-analyzer-section-health = Health & Growth
plant-analyzer-section-genetics = Genetic Parameters
plant-analyzer-section-threats = Environment & Threats
plant-analyzer-section-soil-reagents = Soil Composition
plant-analyzer-section-produce-reagents = Produce Composition

# Headers and Names
plant-analyzer-target = Target: { $name }
plant-analyzer-no-plant = Plant: [None]
plant-analyzer-plant-name = Plant: { $name }

# Statuses
plant-analyzer-status-dead = Status: Dead
plant-analyzer-status-harvestable = Status: Ready for harvest
plant-analyzer-status-growing = Plant age { $age }

# Metrics
plant-analyzer-health-value = Health: { $health } / { $max }
plant-analyzer-potency = Potency: { $potency }
plant-analyzer-yield = Yield: { $yield }
plant-analyzer-mutation = Mutation status: MUTATING! { $mutation }
plant-analyzer-mutation-non = Mutation status: Stable { $mutation }
plant-analyzer-growth-rate = Rapid fruiting time: { $growthRate }
plant-analyzer-exude-gases = Exuded gases: { $gases }
plant-analyzer-exude-gases-none = Gas exudation: None

# Threats
plant-analyzer-weeds = Weeds: { $level }
plant-analyzer-weeds-danger = Weeds: { $level } (DANGER)
plant-analyzer-pests = Pests: { $level }
plant-analyzer-pests-danger = Pests: { $level } (DANGER)
plant-analyzer-toxins = Toxins: { $level }
plant-analyzer-toxins-danger = Toxins: { $level } (DANGER)

# Reagents
plant-analyzer-no-soil-reagents = Soil is pure or solution is absent.
plant-analyzer-no-produce-reagents = Produce contains no chemicals.
plant-analyzer-reagent-entry = • { $reagent }: { $quantity }u

# Popups
plant-analyzer-target-invalid = Target contains no plant biomass or substrate.
